# Copy to .env for local development. On Render, set these in the Web Service env vars.
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# TiDB Connection Parameters (DB_* names also supported)
TIDB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=4CzX2YavwHHzQ2f.root
TIDB_PASSWORD=your-tidb-password
TIDB_DB_NAME=curious_books

# SSL/TLS Configuration
TIDB_ENABLE_SSL=true
# Optional — defaults to certs/isrgrootx1.pem when missing or invalid
# TIDB_CA_PATH=certs/isrgrootx1.pem

CORS_ORIGINS=http://localhost:5173
PORT=5000

# Optional API key required on /api/* routes
# API_KEY=
