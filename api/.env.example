# Copy to .env for local development. On Render, set these in the Web Service env vars.
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# TiDB Cloud (TLS is enabled automatically for *.tidbcloud.com hosts)
DB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=4CzX2YavwHHzQ2f.root
DB_PASSWORD=your-tidb-password
DB_NAME=curious_books
# Optional override — defaults to certs/isrgrootx1.pem for TiDB Cloud
# DB_SSL_CA=certs/isrgrootx1.pem

CORS_ORIGINS=http://localhost:5173
PORT=5000

# Optional API key required on /api/* routes
# API_KEY=
