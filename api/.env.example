# Copy to .env for local development. On Render, set these in the Web Service env vars.
#FLASK_ENV=development
#SECRET_KEY=change-me
#JWT_SECRET_KEY=change-me

# Preferred: full TiDB connection string (mysql:// is auto-converted to mysql+pymysql://)
#TIDB_DATABASE_URL=mysql://4CzX2YavwHHzQ2f.root:your-password@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/curious_books
#TIDB_ENABLE_SSL=true

# Alternative: component env vars (used only when TIDB_DATABASE_URL / DATABASE_URL is unset)
# TIDB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=4CzX2YavwHHzQ2f.root
# TIDB_PASSWORD=your-password
# TIDB_DB_NAME=curious_books

#CORS_ORIGINS=http://localhost:5173
#PORT=5000

# Content-based recommendations (TF-IDF). Train with: python train_recommender.py
#RECOMMENDER_ENABLED=true
#RECOMMENDER_MODEL_PATH=models/recommender

# Optional API key required on /api/* routes
# API_KEY=


# Copy to .env for local development

FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Local MySQL Database
TIDB_DATABASE_URL=mysql+pymysql://jk:Good2Manage1%21@127.0.0.1:5454/curious_books

# TIDB_PORT=5454
# TIDB_USER=jk
# TIDB_PASSWORD=your-password
# TIDB_DB_NAME=curious_books


# Not needed for local MySQL
TIDB_ENABLE_SSL=false

CORS_ORIGINS=http://localhost:5173
PORT=5000

# Content-based recommendations (TF-IDF)
RECOMMENDER_ENABLED=true
RECOMMENDER_MODEL_PATH=models/recommender

# Optional API key required on /api/* routes
# API_KEY=